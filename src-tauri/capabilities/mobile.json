{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mobile",
  "description": "Capability for Android and iOS mobile",
  "platforms": ["android", "iOS"],
  "windows": ["TeleDrive"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-applocaldata-write-recursive",
    "fs:allow-applocaldata-read-recursive",
    "stronghold:default"
  ]
}
